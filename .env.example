# Browser-side Supabase values are used by legacy media routes that remain in the repository.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>

# NoticeFlow frontend target. In production use the HTTPS origin of the deployed backend.
VITE_SCHOOL_API_URL=https://api.your-school-platform.example
